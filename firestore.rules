rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Reads the caller's role from users collection (used in other rules)
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return request.auth != null && role() in ["admin", "superadmin"];
    }

    function isSuperAdmin() {
      return request.auth != null && role() == "superadmin";
    }

    function isDemo() {
      return request.auth != null && role() == "demo";
    }

    function isTechnician() {
      return request.auth != null && role() == "technician";
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Any authenticated user can read their own profile (needed on login)
      // Demo users can only read their own profile — not other users' PII
      allow read: if isOwner(uid) || isAdmin();

      // Admins create new user docs (after Cloud Function creates the Auth account)
      allow create: if isAdmin();

      // Technicians can update only their own doc, and only safe fields
      // (fcmTokens for push notifications, photoUrl)
      allow update: if isOwner(uid) && isTechnician()
                       && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(["fcmTokens", "photoUrl"])
                    || isAdmin();

      // Only superadmins can delete user docs (prevents admin → superadmin deletion)
      allow delete: if isSuperAdmin()
                       && uid != request.auth.uid  // cannot delete self
                       && resource.data.role != "superadmin"; // cannot delete other superadmins
    }

    // ── jobs ─────────────────────────────────────────────────────────────────
    match /jobs/{jobId} {
      // Admins read all jobs; demo only reads jobs seeded as demo data
      allow read: if isAdmin();
      allow read: if isDemo() && resource.data.isDemo == true;

      // Technicians can only read jobs assigned to them
      allow read: if isTechnician()
                     && resource.data.assignedTo == request.auth.uid;

      // Only admins can create/update/delete jobs
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── sites ─────────────────────────────────────────────────────────────────
    match /sites/{siteId} {
      allow read: if isAdmin() || isTechnician();
      allow read: if isDemo() && resource.data.isDemo == true;
      allow create, update, delete: if isAdmin();
    }

    // ── counters ─────────────────────────────────────────────────────────────
    // Atomic ID counters — admins read/write, no client-visible data
    match /counters/{counter} {
      allow read, write: if isAdmin();
    }

    // ── reports ───────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      // Admins read all reports; demo only reads reports seeded as demo data
      allow read: if isAdmin();
      allow read: if isDemo() && resource.data.isDemo == true;

      // Technicians can read and write only their own reports
      allow read: if isTechnician()
                     && resource.data.technicianId == request.auth.uid;

      // Technicians create reports — technicianId must match their own uid
      allow create: if isTechnician()
                       && request.resource.data.technicianId == request.auth.uid;

      // Technicians can update their own reports (e.g. editedAt); admins can add notes
      allow update: if isTechnician()
                       && resource.data.technicianId == request.auth.uid
                    || isAdmin();

      // Only admins can delete reports
      allow delete: if isAdmin();
    }

  }
}
